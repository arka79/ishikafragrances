# Copy this file to .env, then paste the values from
# Firebase console → Project settings → Your apps → Web app.
#
# These are public web-app identifiers, not secrets: they end up in the
# browser bundle anyway. Access control lives in firebase/firestore.rules.
# Never put a service-account key or private key in a VITE_ variable.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
